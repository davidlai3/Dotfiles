# bash-specific setup. Everything portable (PATH, aliases, toolchains) lives in
# shell/common.sh, which is sourced near the bottom.

# Interactive shells only.
case $- in
	*i*) ;;
	*) return ;;
esac

# --- History ---------------------------------------------------------------
HISTCONTROL=ignoreboth        # no duplicates, no lines starting with a space
HISTSIZE=10000
HISTFILESIZE=20000
shopt -s histappend           # append rather than overwrite on exit
shopt -s checkwinsize

[ -x /usr/bin/lesspipe ] && eval "$(SHELL=/bin/sh lesspipe)"

# --- Prompt ----------------------------------------------------------------
# Approximates the robbyrussell zsh theme: ➜  dir git:(branch) ✗
# Built in PROMPT_COMMAND rather than inlined into PS1 so that the \[ \]
# non-printing markers are seen by bash's prompt expansion (they are not when
# emitted from a command substitution, which corrupts line wrapping).
case "$TERM" in
	xterm*|rxvt*|screen*|tmux*) _term_title='\[\e]0;\u@\h: \w\a\]' ;;
	*) _term_title='' ;;
esac

_set_prompt() {
	local git="" ref
	ref=$(git symbolic-ref --short HEAD 2>/dev/null || git rev-parse --short HEAD 2>/dev/null)
	if [ -n "$ref" ]; then
		git=' \[\e[1;34m\]git:(\[\e[1;31m\]'"$ref"'\[\e[1;34m\])\[\e[0m\]'
		[ -n "$(git status --porcelain 2>/dev/null)" ] && git+=' \[\e[1;33m\]✗\[\e[0m\]'
	fi
	PS1="$_term_title"'\[\e[1;32m\]➜  \[\e[1;36m\]\W\[\e[0m\]'"$git"' '
}
PROMPT_COMMAND=_set_prompt

# --- Keybindings -----------------------------------------------------------
set -o vi

# Closest bash has to zsh-history-substring-search: up/down search history for
# lines matching what is already typed. There is no built-in equivalent of
# zsh-autosuggestions (^F accept) or zsh-syntax-highlighting; ble.sh provides
# both if they are ever worth the startup cost.
bind '"\e[A": history-search-backward'
bind '"\e[B": history-search-forward'

# --- Completion ------------------------------------------------------------
if ! shopt -oq posix; then
	if [ -f /usr/share/bash-completion/bash_completion ]; then
		. /usr/share/bash-completion/bash_completion
	elif [ -f /etc/bash_completion ]; then
		. /etc/bash_completion
	fi
fi

# --- Shared environment ----------------------------------------------------
[ -r "$HOME/.config/shell/common.sh" ] && . "$HOME/.config/shell/common.sh"

# nvm itself is loaded by common.sh; its completion is bash-only.
[ -s "$NVM_DIR/bash_completion" ] && . "$NVM_DIR/bash_completion"

# --- opam ------------------------------------------------------------------
[ ! -r "$HOME/.opam/opam-init/init.sh" ] || . "$HOME/.opam/opam-init/init.sh" > /dev/null 2> /dev/null
