# zsh-specific setup. Everything portable (PATH, aliases, toolchains) lives in
# shell/common.sh, which is sourced near the bottom.

# --- oh-my-zsh -------------------------------------------------------------
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"

# Standard plugins live in $ZSH/plugins/, custom ones in $ZSH_CUSTOM/plugins/.
# Add wisely, as too many plugins slow down shell startup.
plugins=(git zsh-autosuggestions zsh-syntax-highlighting zsh-history-substring-search)
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=#586E75"

source $ZSH/oh-my-zsh.sh

# --- Keybindings -----------------------------------------------------------
bindkey -v
bindkey '^F' autosuggest-accept

# --- Shared environment ----------------------------------------------------
# After oh-my-zsh.sh so its aliases (git plugin) can be overridden.
[ -r "$HOME/.config/shell/common.sh" ] && . "$HOME/.config/shell/common.sh"

# --- opam ------------------------------------------------------------------
[[ ! -r "$HOME/.opam/opam-init/init.zsh" ]] || source "$HOME/.opam/opam-init/init.zsh" > /dev/null 2> /dev/null

